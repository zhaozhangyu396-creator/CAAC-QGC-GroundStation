+class GeofenceNoLandTest : public ::testing::Test
+{
+protected:
+	void SetUp() override
+	{
+		param_control_autosave(false);
+		setInt("GF_ACTION", 2);
+		setInt("GF_NOLAND", 1);
+		setInt("NAV_RCL_ACT", 2);
+		setInt("NAV_DLL_ACT", 0);
+		setInt("COM_RC_IN_MODE", 0);
+		setInt("COM_LOW_BAT_ACT", 2);
+		const float delay = 0.f;
+		ASSERT_EQ(param_set(param_find("COM_FAIL_ACT_T"), &delay), 0);
+		state.armed = true;
+		state.user_intended_mode = vehicle_status_s::NAVIGATION_STATE_ALTCTL;
+		state.vehicle_type = vehicle_status_s::VEHICLE_TYPE_ROTARY_WING;
+	}
+
+	static void setInt(const char *name, int32_t value)
+	{
+		ASSERT_NE(param_find(name), PARAM_INVALID);
+		ASSERT_EQ(param_set(param_find(name), &value), 0);
+	}
+
+	void blockMode(uint8_t mode)
+	{
+		flags.mode_req_other |= 1u << mode;
+	}
+
+	uint8_t update(Failsafe &failsafe, hrt_abstime elapsed = 10_ms, bool mode_updated = false)
+	{
+		time += elapsed;
+		return failsafe.update(time, state, mode_updated, false, flags);
+	}
+
+	FailsafeBase::State state{};
+	failsafe_flags_s flags{};
+	hrt_abstime time{5_s};
+};
+
+TEST_F(GeofenceNoLandTest, availableHoldAndPilotModeSwitch)
+{
+	Failsafe failsafe(nullptr);
+	update(failsafe);
+	flags.geofence_breached = true;
+	EXPECT_EQ(update(failsafe), state.user_intended_mode);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Hold);
+	state.user_intended_mode = vehicle_status_s::NAVIGATION_STATE_STAB;
+	EXPECT_EQ(update(failsafe, 10_ms, true), state.user_intended_mode);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Warn);
+}
+
+TEST_F(GeofenceNoLandTest, unavailableHoldKeepsPilotModeWithoutEscalation)
+{
+	Failsafe failsafe(nullptr);
+	update(failsafe);
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_RTL);
+	flags.geofence_breached = true;
+
+	for (hrt_abstime elapsed : {10_ms, 6_s, 120_s}) {
+		EXPECT_EQ(update(failsafe, elapsed), state.user_intended_mode);
+		EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Warn);
+		EXPECT_EQ(FailsafeBase::modeFromAction(failsafe.selectedAction(), state.user_intended_mode),
+			  state.user_intended_mode);
+	}
+}
+
+TEST_F(GeofenceNoLandTest, persistentBreachLosesHoldAndRepeatsAlarm)
+{
+	Failsafe failsafe(nullptr);
+	int notifications = 0;
+	failsafe.setOnNotifyUserCallback([](void *arg) { ++*static_cast<int *>(arg); }, &notifications);
+	update(failsafe);
+	flags.geofence_breached = true;
+	update(failsafe);
+	ASSERT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Hold);
+	const int initial_notifications = notifications;
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_RTL);
+	EXPECT_EQ(update(failsafe), state.user_intended_mode);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Warn);
+	EXPECT_EQ(notifications, initial_notifications + 1);
+	update(failsafe, 2_s);
+	EXPECT_EQ(notifications, initial_notifications + 1);
+	update(failsafe, 4_s);
+	EXPECT_EQ(notifications, initial_notifications + 2);
+}
+
+TEST_F(GeofenceNoLandTest, clearedBreachLatchedHoldAlsoCannotLand)
+{
+	Failsafe failsafe(nullptr);
+	update(failsafe);
+	flags.geofence_breached = true;
+	update(failsafe);
+	ASSERT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Hold);
+	flags.geofence_breached = false;
+	update(failsafe);
+	ASSERT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Hold);
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_RTL);
+	EXPECT_EQ(update(failsafe), state.user_intended_mode);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Warn);
+	state.user_intended_mode = vehicle_status_s::NAVIGATION_STATE_STAB;
+	update(failsafe, 10_ms, true);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::None);
+}
+
+TEST_F(GeofenceNoLandTest, independentBatteryLandIsUnchanged)
+{
+	Failsafe failsafe(nullptr);
+	update(failsafe);
+	flags.geofence_breached = true;
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_RTL);
+	flags.battery_warning = battery_status_s::WARNING_EMERGENCY;
+	update(failsafe);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Land);
+}
+
+TEST_F(GeofenceNoLandTest, independentRcFailsafeStillFallsBackToLand)
+{
+	Failsafe failsafe(nullptr);
+	update(failsafe);
+	flags.geofence_breached = true;
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_RTL);
+	flags.manual_control_signal_lost = true;
+	update(failsafe);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Land);
+}
+
+TEST_F(GeofenceNoLandTest, invalidPilotModeStillUsesNativePositionFallback)
+{
+	Failsafe failsafe(nullptr);
+	update(failsafe);
+	flags.geofence_breached = true;
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+	blockMode(vehicle_status_s::NAVIGATION_STATE_ALTCTL);
+	update(failsafe);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::FallbackStab);
+}
+
+TEST_F(GeofenceNoLandTest, disabledPolicyKeepsNativeLandFallback)
+{
+	setInt("GF_NOLAND", 0);
+	Failsafe failsafe(nullptr);
+	update(failsafe);
+	flags.geofence_breached = true;
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_RTL);
+	update(failsafe);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Land);
+}
+
+TEST_F(GeofenceNoLandTest, otherGeofenceActionIsUnchanged)
+{
+	setInt("GF_ACTION", 5);
+	Failsafe failsafe(nullptr);
+	update(failsafe);
+	flags.geofence_breached = true;
+	update(failsafe);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Land);
+}
+
+TEST_F(GeofenceNoLandTest, fixedWingIsUnchanged)
+{
+	state.vehicle_type = vehicle_status_s::VEHICLE_TYPE_FIXED_WING;
+	Failsafe failsafe(nullptr);
+	update(failsafe);
+	flags.geofence_breached = true;
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_RTL);
+	update(failsafe);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Land);
+}
+
+
+class ReconfigurableGeofenceFailsafe : public Failsafe
+{
+public:
+	ReconfigurableGeofenceFailsafe() : Failsafe(nullptr) {}
+	using Failsafe::updateParams;
+};
+
+TEST_F(GeofenceNoLandTest, latchedHoldPolicyDisablesWithDifferentAction)
+{
+	ReconfigurableGeofenceFailsafe failsafe;
+	update(failsafe);
+	flags.geofence_breached = true;
+	update(failsafe);
+	flags.geofence_breached = false;
+	update(failsafe);
+	ASSERT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Hold);
+	setInt("GF_ACTION", 5);
+	failsafe.updateParams();
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_RTL);
+	update(failsafe);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Land);
+}
+
+TEST_F(GeofenceNoLandTest, latchedHoldPolicyDisablesWhenOptedOut)
+{
+	ReconfigurableGeofenceFailsafe failsafe;
+	update(failsafe);
+	flags.geofence_breached = true;
+	update(failsafe);
+	flags.geofence_breached = false;
+	update(failsafe);
+	ASSERT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Hold);
+	setInt("GF_NOLAND", 0);
+	failsafe.updateParams();
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_RTL);
+	update(failsafe);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Land);
+}
+
+TEST_F(GeofenceNoLandTest, latchedHoldPolicyDisablesForFixedWing)
+{
+	Failsafe failsafe(nullptr);
+	update(failsafe);
+	flags.geofence_breached = true;
+	update(failsafe);
+	flags.geofence_breached = false;
+	update(failsafe);
+	ASSERT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Hold);
+	state.vehicle_type = vehicle_status_s::VEHICLE_TYPE_FIXED_WING;
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_RTL);
+	update(failsafe);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Land);
+}
+
+TEST_F(GeofenceNoLandTest, orbitRequestIsNotRewrittenToUnavailableLoiter)
+{
+	state.user_intended_mode = vehicle_status_s::NAVIGATION_STATE_ORBIT;
+	Failsafe failsafe(nullptr);
+	update(failsafe);
+	flags.geofence_breached = true;
+	update(failsafe);
+	ASSERT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Hold);
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+	blockMode(vehicle_status_s::NAVIGATION_STATE_AUTO_RTL);
+
+	for (hrt_abstime elapsed : {10_ms, 6_s, 120_s}) {
+		state.user_intended_mode = update(failsafe, elapsed);
+		EXPECT_EQ(state.user_intended_mode, vehicle_status_s::NAVIGATION_STATE_ORBIT);
+		EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Warn);
+	}
+}
