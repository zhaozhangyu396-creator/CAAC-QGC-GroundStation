 PARAM_DEFINE_INT32(GF_ACTION, 2);

+/**
+ * Keep pilot mode if geofence Hold is unavailable.
+ *
+ * Custom CAAC training capability. For multirotors with GF_ACTION=2 only,
+ * an unavailable geofence Hold action becomes a warning instead of falling
+ * back to Return, Land, Descend or Terminate. The requested pilot mode is
+ * retained if it is runnable. Independent failsafes retain their normal
+ * actions. This does not detect physical braking performance.
+ *
+ * @min 0
+ * @max 1
+ * @value 0 Native fallback
+ * @value 1 Warn and retain pilot mode
+ * @group Geofence
+ */
+PARAM_DEFINE_INT32(GF_NOLAND, 0);
+
 /**
  * Geofence source
  *
